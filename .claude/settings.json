{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/test-gate.py\" turn-start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/test-gate.py\" stop",
            "timeout": 300,
            "statusMessage": "agy test gate"
          }
        ]
      }
    ]
  }
}
