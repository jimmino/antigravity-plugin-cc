#!/usr/bin/env bash
# Hermetic stand-in for the Claude Code CLI, for second-opinion and ask-claude.
#
# Env knobs:
#   FAKE_CLAUDE_ARGV    path; the run appends its argv here
#   FAKE_CLAUDE_STDIN   path; the run copies its stdin here
#   FAKE_CLAUDE_RESULT  the answer text (default: an independent answer)
#   FAKE_CLAUDE_ERROR   1 => report is_error with an auth-shaped message
#   FAKE_CLAUDE_PWD     path; the run records its working directory here
#   FAKE_CLAUDE_HELP    old => `--help` lists no --restricted flag
set -u

# The capability probe. It must not touch the run's argv or stdin records.
if [ "${1:-}" = "--help" ]; then
  echo "Usage: claude [options] [command] [prompt]"
  echo "  --permission-mode <mode>              Permission mode to use for the session"
  echo "  --setting-sources <sources>           Comma-separated list of setting sources"
  if [ "${FAKE_CLAUDE_HELP:-}" != "old" ]; then
    echo "  --restricted                          Restricted mode: removes the built-in"
  fi
  echo "  --strict-mcp-config                   Only use MCP servers from --mcp-config"
  exit 0
fi

if [ -n "${FAKE_CLAUDE_PWD:-}" ]; then pwd > "$FAKE_CLAUDE_PWD"; fi

if [ -n "${FAKE_CLAUDE_ARGV:-}" ]; then
  : > "$FAKE_CLAUDE_ARGV"
  for a in "$@"; do printf '%s\n' "$a" >> "$FAKE_CLAUDE_ARGV"; done
fi

if [ -n "${FAKE_CLAUDE_STDIN:-}" ]; then
  cat > "$FAKE_CLAUDE_STDIN"
else
  cat > /dev/null
fi

if [ "${FAKE_CLAUDE_ERROR:-0}" = "1" ]; then
  printf '{"is_error":true,"result":"authentication failed","num_turns":1}\n'
  exit 0
fi

RESULT="${FAKE_CLAUDE_RESULT:-an independent answer}" python3 -c "
import json, os
print(json.dumps({
    'is_error': False,
    'result': os.environ['RESULT'],
    'num_turns': 3,
    'total_cost_usd': 0.0421,
}))"
